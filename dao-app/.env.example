# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Sepolia RPC endpoint (URL from your provider's dashboard)
SEPOLIA_RPC_URL=https://sepolia.rpc.example.com/v2/YOUR_API_KEY_HERE

# Oracle signing key (used by scripts/mpc-bridge).
# Use a dedicated TESTNET wallet with no real funds. Never commit the real value.
PRIVATE_KEY=YOUR_TESTNET_PRIVATE_KEY_HERE

# WARNING: variables starting with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in them.
NEXT_PUBLIC_DAO_ADDRESS=YOUR_DAO_ADDRESS_HERE
NEXT_PUBLIC_TOKENVOTING_ADDRESS=YOUR_TOKENVOTING_ADDRESS_HERE
